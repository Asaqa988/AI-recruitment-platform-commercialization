# --- core ---
# dev | production. production refuses to start with the default APP_SECRET.
APP_ENV=dev
APP_SECRET=change-me-to-a-long-random-string
# Comma separated. Anyone who registers with one of these emails becomes admin.
ADMIN_EMAILS=you@example.com
DB_PATH=data/hire.db
# Candidate pipelines every new account gets for free (0 disables).
FREE_CREDITS=1
# Most times one stage can run for one candidate (caps model spend).
MAX_STAGE_ATTEMPTS=5

# --- payments ---
# demo   = "Pay" instantly adds the credits (testing / demos)
# manual = customer pays by bank transfer / CliQ and submits a reference; you confirm it in /admin
PAYMENT_MODE=manual
PAYMENT_INSTRUCTIONS=Pay by CliQ alias ZYNDESK or bank transfer, then paste the transfer reference.

# --- engine ---
# auto = live CrewAI crew when crewai + an LLM key are present, otherwise the labelled sample-data engine
ENGINE=auto
# CREW_MODEL picks the provider: openai/gpt-4o-mini, gemini/gemini-2.5-flash, anthropic/...
# (the original crew used openai/gpt-5.6-luna; set it here if your account has it)
CREW_MODEL=openai/gpt-4o-mini
# optional stronger model for the writing agents only (emails, salary reply, report)
# CREW_WRITER_MODEL=openai/gpt-4o
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
